# Bu dosyayı kopyalayın: cp .env.example .env
# Gerçek anahtarları asla Git'e eklemeyin (.env zaten .gitignore'da).

# Google Gemini (sesli asistan / canlı API) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı model adları
# GEMINI_MODEL=models/gemini-3.1-flash-live-preview
# GEMINI_TEXT_MODEL=gemini-flash-latest

# Sunucu
PORT=3000

# MQTT (NodeMCU / ESP cihazlar)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Ollama (cihaz adından sesli komut anahtar kelimesi üretimi)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# faster-whisper (yerel ses tanıma)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# SQLite veritabanı yolu (içinde API anahtarı saklanabilir — commit etmeyin)
# SMARTHOME_DB=./smarthome.db
